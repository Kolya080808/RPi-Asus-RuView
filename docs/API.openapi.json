{
  "openapi": "3.0.3",
  "info": {
    "title": "RuView local workspace API",
    "version": "2.0.0",
    "description": "Trusted LAN panel. Points and labels are references, not inferred positions. Writes use X-Panel-Token from /api/health and same-origin JSON. Historical map_at_capture is null. Capture is bounded and manually controlled from the panel."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Panel state, storage counts and ephemeral write_token; source is not monitored",
        "responses": {
          "200": {
            "description": "Current local panel state."
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "System"
        ]
      }
    },
    "/api/map": {
      "get": {
        "summary": "Reference geometry, documented devices and hashes",
        "responses": {
          "200": {
            "description": "Floorplan, documented devices, and source hashes."
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Map and references"
        ]
      }
    },
    "/api/points": {
      "get": {
        "summary": "Saved reference points",
        "responses": {
          "200": {
            "description": "Saved reference data."
          },
          "400": {
            "description": "Stored metadata could not be decoded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Map and references"
        ]
      },
      "post": {
        "summary": "Append point",
        "security": [
          {
            "PanelToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Point"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reference item saved."
          },
          "400": {
            "description": "Invalid fields, coordinates, or reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token missing/expired or request origin not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Identifier already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON request body required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Map and references"
        ]
      }
    },
    "/api/routes": {
      "get": {
        "summary": "Ordered reference routes and point snapshots",
        "responses": {
          "200": {
            "description": "Saved reference data."
          },
          "400": {
            "description": "Stored metadata could not be decoded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Map and references"
        ]
      },
      "post": {
        "summary": "Append route",
        "security": [
          {
            "PanelToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
