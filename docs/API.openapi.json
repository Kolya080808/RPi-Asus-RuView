    "/api/captures/{id}/{action}": {
      "post": {
        "summary": "Pause, resume or stop a manual capture",
        "security": [
          {
            "PanelToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "pause",
                "resume",
                "stop"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Capture action accepted."
          },
          "400": {
            "description": "Malformed or invalid JSON request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token missing/expired or request origin not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Action route not found.",
