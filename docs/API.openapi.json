        "description": "Paused or already stopping captures are stopped and joined for up to 12 seconds before deletion. A running capture is rejected. If the worker remains alive, all session data are retained.",
        "tags": [
          "Sessions and replay"
        ]
      }
    },
    "/api/captures/{id}/live": {
      "get": {
        "summary": "Incremental live signal window, processed once on arrival",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": -1,
              "default": -1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capture lifecycle, new samples, next_seq, reset, last_sample_age_s and signal_error; at most 600 points. reset replaces the client window."
          },
          "400": {
            "description": "Stored session metadata could not be decoded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server or local storage failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "Capture control"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CaptureRequest": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1800,
            "default": 60
          },
          "interval_ms": {
            "type": "integer",
            "enum": [
              100,
              200,
              500
            ],
            "default": 100
          }
        }
      },
      "Point": {
        "type": "object",
        "required": [
          "label",
          "x",
          "y"
        ],
        "properties": {
          "id": {
