        ]
      }
    },
    "/api/sessions/{id}": {
      "get": {
        "summary": "Session metadata and labels; original map unavailable",
        "responses": {
          "200": {
            "description": "Session metadata and annotations."
          },
          "400": {
            "description": "Stored session metadata could not be decoded.",
